# Configuration for the hosted web app (`npm start`). The desktop app does not
# read any of these — it keeps its own credentials in the OS keychain.
#
# None of these are VITE_* variables: anything with that prefix is inlined into
# the public bundle. Every value here stays in the server process.

# OAuth client from Google Cloud. Reuse the existing "Web application" client and
# add this deployment's callback to its Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match a redirect URI registered on the OAuth client, exactly.
# Use https:// anywhere other than local development.
OAUTH_REDIRECT_URI=https://your-deployment.example.com/api/auth/callback

# 32-byte key that seals the session cookie. Generate with:
#   openssl rand -hex 32
# Rotating it signs every user out; it never needs to be shared with anyone.
SESSION_SECRET=

# Access gate. REQUIRED: the server refuses to start without it, and rejects
# anything shorter than 12 characters. It is the only thing between this
# deployment and the open internet, so generate it — do not choose it by hand:
#   openssl rand -base64 24
APP_PASSPHRASE=

# How long an unlocked browser stays unlocked, in hours (default 12). Ticking
# "Remember this device" on the unlock page extends that session to 30 days.
GATE_TTL_HOURS=12

# Optional.
PORT=42814
HOST=0.0.0.0
# Set to 0 when the process is exposed directly, with no reverse proxy in front.
TRUST_PROXY=1

# Development only: serve generated data instead of calling Google, so the whole
# flow can be exercised without credentials. Never enable in production.
# MOCK_HEALTH=1

# Development only: run with the access gate open. Never set this on a
# deployment that can be reached from the internet.
# ALLOW_NO_PASSPHRASE=1
